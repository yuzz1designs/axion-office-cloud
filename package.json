{
  "name": "axion-office-cloud",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "desktop:build": "npm run build && npm run companion:build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && node scripts/start-desktop.mjs",
    "desktop:package": "npm run desktop:build && electron-builder --mac --universal --dir && node scripts/finalize-desktop.mjs",
    "desktop:package:arm64": "npm run desktop:build && electron-builder --mac --arm64 --dir && node scripts/finalize-desktop.mjs",
    "desktop:package:intel": "npm run desktop:build && electron-builder --mac --x64 --dir && node scripts/finalize-desktop.mjs",
    "precompanion": "node scripts/build-companion.mjs --if-needed",
    "companion": "node --import tsx companion/server.ts",
    "discord:bot": "node --import tsx discord/bot.ts",
    "companion:build": "node scripts/build-companion.mjs",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.8.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
