# Nunca use VITE_OPENAI_API_KEY: variáveis VITE são expostas ao browser.
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.4
OPENAI_AIVA_MARK_I_MODEL=gpt-5.4
# Mark II usa gpt-6-astra exclusivamente; a disponibilidade é verificada no servidor.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Google Sheets CRM — credenciais exclusivas do servidor, nunca usar prefixo VITE_.
