{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axion-office-cloud",
  "main": "worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NODE_ENV": "production",
    "AXION_RUNTIME": "cloudflare",
    "AXION_AIVA_ENABLED": "false",
    "GOOGLE_OAUTH_REDIRECT_URI": "https://axion-office-cloud.nelsonafonsoprofissional.workers.dev/api/google/oauth/callback",
    "GOOGLE_WORKSPACE_OAUTH_REDIRECT_URI": "https://axion-office-cloud.nelsonafonsoprofissional.workers.dev/api/google/workspace/oauth/callback",
    "GOOGLE_QUOTES_GMAIL_REDIRECT_URI": "https://axion-office-cloud.nelsonafonsoprofissional.workers.dev/api/quotes/gmail/oauth/callback",
    "AXION_QUOTES_GMAIL": "axionportugal@gmail.com",
    "VAPID_SUBJECT": "mailto:axionportugal@gmail.com",
    "VAPID_PUBLIC_KEY": "BALJXcW_lqUWnJqpP5GDkV-wGNLEtQ7ncEgo1qNqxuHVAVe9P5GQ8hSqkdd6jNTXTLyfOirCG--DeAm77sij6YQ"
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] }
}
